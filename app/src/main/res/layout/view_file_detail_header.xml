<?xml version="1.0" encoding="utf-8"?>
<!-- Item 0 of the detail page's list: the transcript actions, Summary, Highlights, Automations,
     the "Transcript" section header the paragraphs start under, and the empty / loading states
     that stand in when there are no paragraphs. FileDetailActivity fills it in directly (it is
     inflated once and handed to the list adapter). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/detailHeader"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp">

    <!-- Transcript actions (only when a transcript exists) -->
    <LinearLayout
        android:id="@+id/transcriptActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/copyTranscriptButton"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:fontFamily="sans-serif"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minHeight="0dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/action_copy_transcript"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            app:cornerRadius="18dp"
            app:rippleColor="@color/tab_selected_bg"
            app:strokeColor="@color/light_gray" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/exportMarkdownButton"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:fontFamily="sans-serif"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minHeight="0dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/action_export_markdown"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            app:cornerRadius="18dp"
            app:rippleColor="@color/tab_selected_bg"
            app:strokeColor="@color/light_gray" />
    </LinearLayout>

    <!-- Summary block (only when a summary exists): header with a Copy action, then the text -->
    <LinearLayout
        android:id="@+id/summaryHeaderRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/summaryHeader"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:text="@string/summary"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/copySummaryButton"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackground"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="@string/copy"
            android:textColor="@color/gray7"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/summaryText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="sans-serif"
        android:lineSpacingExtra="4dp"
        android:textColor="@color/dark_gray"
        android:textIsSelectable="true"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- Highlights (only when the transcript carries button-press highlights): header plus
         one tappable row per highlight, filled in code -->
    <TextView
        android:id="@+id/highlightsHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="sans-serif-medium"
        android:text="@string/highlights"
        android:textColor="@color/text_primary"
        android:textSize="15sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/highlightsList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="vertical"
        android:visibility="gone" />

    <!-- Automations (server recordings only): what the automations did with this recording.
         Header plus one block per run (routes, reasons, delivery outcomes), filled in code; a
         one-line empty state when nothing matched, and a text button that reveals earlier runs. -->
    <TextView
        android:id="@+id/automationsHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="sans-serif-medium"
        android:text="@string/automations"
        android:textColor="@color/text_primary"
        android:textSize="15sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/automationsList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="vertical"
        android:visibility="gone" />

    <TextView
        android:id="@+id/automationsEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="sans-serif"
        android:text="@string/automations_none"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/automationsShowEarlier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="?attr/selectableItemBackground"
        android:fontFamily="sans-serif-medium"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:text="@string/automations_show_earlier"
        android:textColor="@color/gray7"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- Where the transcript body starts -->
    <TextView
        android:id="@+id/transcriptSectionHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:fontFamily="sans-serif-medium"
        android:text="@string/transcript"
        android:textColor="@color/text_primary"
        android:textSize="15sp"
        android:visibility="gone" />

    <!-- A long transcript on its way from the server (or still being read) -->
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/transcriptLoading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:contentDescription="@string/detail_transcript_loading"
        android:indeterminate="true"
        android:visibility="gone"
        app:indicatorColor="@color/gray_ad"
        app:trackColor="@color/separator"
        app:trackCornerRadius="2dp"
        app:trackThickness="3dp" />

    <!-- Empty state: why there is no transcript, and the one button that may change that -->
    <LinearLayout
        android:id="@+id/emptyState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:id="@+id/emptyIcon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_files"
            app:tint="@color/text_secondary" />

        <TextView
            android:id="@+id/emptyTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/emptySubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <!-- The raw failure text, behind a disclosure -->
        <TextView
            android:id="@+id/emptyDetailsToggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="?attr/selectableItemBackground"
            android:fontFamily="sans-serif-medium"
            android:padding="8dp"
            android:text="@string/detail_error_details"
            android:textColor="@color/gray7"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/emptyDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="@color/gray7"
            android:textIsSelectable="true"
            android:textSize="12sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/generateButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_primary_button"
            android:fontFamily="sans-serif"
            android:text="@string/check_transcript"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:visibility="gone"
            app:backgroundTint="@null" />
    </LinearLayout>

    <!-- Breathing room before the first paragraph -->
    <View
        android:layout_width="match_parent"
        android:layout_height="4dp" />
</LinearLayout>
