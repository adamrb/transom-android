<?xml version="1.0" encoding="utf-8"?>
<!-- One transcript paragraph: a meta line (speaker label where the speaker changes, a time chip
     that plays from there) over the selectable text. A bookmarked paragraph carries the accent bar
     and opens with the Highlights rows' star. The row background tints while it is playing. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/paragraphRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="10dp"
    android:paddingEnd="24dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:id="@+id/metaRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/speakerLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:contentDescription="@string/detail_rename_speaker_cd"
            android:fontFamily="sans-serif-medium"
            android:layout_marginEnd="8dp"
            android:minHeight="28dp"
            android:gravity="center_vertical"
            android:paddingEnd="4dp"
            android:textColor="@color/gray7"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/timeChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_time_chip"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:minHeight="24dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:textColor="@color/gray7"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <View
            android:id="@+id/bookmarkBar"
            android:layout_width="3dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="12dp"
            android:background="@color/highlight_accent"
            android:visibility="gone" />

        <TextView
            android:id="@+id/paragraphText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/dark_gray"
            android:textIsSelectable="true"
            android:textSize="15sp" />
    </LinearLayout>
</LinearLayout>
