<?xml version="1.0" encoding="utf-8"?>
<!-- Recording detail. The header (title, meta line, status) collapses into the toolbar as the
     page scrolls; the page itself is one RecyclerView whose first item is the summary /
     highlights / automations block (view_file_detail_header) and whose other items are the
     transcript paragraphs, so a two-hour transcript renders as it scrolls. The player sits flush
     to the bottom edge; a "Return to playback" chip appears above it when the reader has
     scrolled away from the paragraph being played. On wide screens FileDetailActivity caps the
     header, list and player to one centred column (ContentWidth). -->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/coordinator"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/colorBackground"
        app:elevation="0dp"
        app:liftOnScroll="false">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/collapsingToolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:contentScrim="?android:attr/colorBackground"
            app:layout_scrollFlags="scroll|exitUntilCollapsed"
            app:scrimAnimationDuration="150"
            app:titleEnabled="false">

            <!-- Expanded header: light title + meta line + status badge + transcription progress -->
            <LinearLayout
                android:id="@+id/headerBlock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/pb_screen_padding"
                android:paddingTop="?attr/actionBarSize"
                android:paddingEnd="@dimen/pb_screen_padding"
                android:paddingBottom="12dp"
                app:layout_collapseMode="parallax"
                app:layout_collapseParallaxMultiplier="0.6">

                <TextView
                    android:id="@+id/fileNameLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-light"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="@dimen/pb_detail_title_text_size" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- "MMM d, yyyy · HH:mm · Xm Ys" -->
                    <TextView
                        android:id="@+id/fileDateLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/statusBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:paddingStart="12dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="4dp"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- Transcription progress (only while the server is working on the recording):
                     determinate when the server reports how far it is, indeterminate otherwise -->
                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/transcriptionProgress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:visibility="gone"
                    app:indicatorColor="?attr/pbColorWarning"
                    app:trackColor="?attr/colorSurfaceVariant"
                    app:trackCornerRadius="2dp"
                    app:trackThickness="3dp" />
            </LinearLayout>

            <!-- Pinned toolbar: back, the condensed title (tap to go back to the top), Jump to, More -->
            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@android:color/transparent"
                app:contentInsetEnd="0dp"
                app:contentInsetStart="0dp"
                app:layout_collapseMode="pin">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/backButton"
                        style="@style/Widget.PlaudBridge.IconButton"
                        android:layout_marginStart="4dp"
                        android:contentDescription="@string/detail_back"
                        android:src="@drawable/ic_chevron_left" />

                    <TextView
                        android:id="@+id/toolbarTitle"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:alpha="0"
                        android:background="?attr/selectableItemBackground"
                        android:contentDescription="@string/detail_back_to_top"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center_vertical"
                        android:maxLines="1"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="17sp" />

                    <ImageButton
                        android:id="@+id/jumpToButton"
                        style="@style/Widget.PlaudBridge.IconButton"
                        android:contentDescription="@string/detail_jump_to"
                        android:src="@drawable/ic_jump_to"
                        android:visibility="gone" />

                    <ImageButton
                        android:id="@+id/moreButton"
                        style="@style/Widget.PlaudBridge.IconButton"
                        android:layout_marginEnd="4dp"
                        android:contentDescription="@string/detail_more"
                        android:src="@drawable/ic_more"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.appbar.MaterialToolbar>
        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- The page: header block (item 0) + one item per transcript paragraph -->
    <FrameLayout
        android:id="@+id/listFrame"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/transcriptList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="24dp"
            android:scrollbars="none" />

        <!-- Full width so the time bubble has room to the left of the thumb; touches outside the
             thumb's column fall through to the list -->
        <org.plaudbridge.app.ui.filedetail.TranscriptFastScroller
            android:id="@+id/fastScroller"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <!-- Bottom: the "Return to playback" chip over the player card -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical">

        <com.google.android.material.chip.Chip
            android:id="@+id/returnToPlayback"
            style="@style/Widget.MaterialComponents.Chip.Action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="8dp"
            android:text="@string/detail_return_to_playback"
            android:textColor="?attr/colorOnPrimary"
            android:visibility="gone"
            app:chipBackgroundColor="?attr/colorPrimary"
            app:chipIcon="@drawable/ic_play_arrow"
            app:chipIconTint="?attr/colorOnPrimary"
            app:chipIconVisible="true"
            app:elevation="4dp" />

        <!-- Player (local audio when the phone has it, else the server stream), flush to the bottom -->
        <LinearLayout
            android:id="@+id/audioPlayer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_player_sheet"
            android:elevation="8dp"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="4dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp"
            android:visibility="gone">

            <com.google.android.material.slider.Slider
                android:id="@+id/progressSlider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:contentDescription="@string/detail_play_pause"
                android:stepSize="0"
                android:valueFrom="0"
                android:valueTo="1"
                app:haloColor="?attr/pbColorSelectionTint"
                app:labelBehavior="floating"
                app:thumbColor="?attr/colorPrimary"
                app:thumbRadius="8dp"
                app:trackColorActive="?attr/colorPrimary"
                app:trackColorInactive="?attr/colorOutline"
                app:trackHeight="3dp" />

            <!-- Elapsed · speed · total -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/currentTimeLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif"
                    android:text="0:00"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="13sp" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/speedChips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:chipSpacingHorizontal="4dp"
                    app:selectionRequired="true"
                    app:singleLine="true"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/speed1x"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="@string/detail_speed_1x"
                        android:textSize="12sp"
                        app:chipMinHeight="28dp"
                        app:chipMinTouchTargetSize="40dp"
                        app:ensureMinTouchTargetSize="true" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/speed1_5x"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/detail_speed_1_5x"
                        android:textSize="12sp"
                        app:chipMinHeight="28dp"
                        app:chipMinTouchTargetSize="40dp"
                        app:ensureMinTouchTargetSize="true" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/speed2x"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/detail_speed_2x"
                        android:textSize="12sp"
                        app:chipMinHeight="28dp"
                        app:chipMinTouchTargetSize="40dp"
                        app:ensureMinTouchTargetSize="true" />
                </com.google.android.material.chip.ChipGroup>

                <TextView
                    android:id="@+id/totalTimeLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif"
                    android:gravity="end"
                    android:text="0:00"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Controls: 15 s back · play/pause · 30 s forward -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/rewindButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/detail_rewind_15">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_replay"
                        app:tint="?attr/pbColorTextBody" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="3dp"
                        android:fontFamily="sans-serif-medium"
                        android:importantForAccessibility="no"
                        android:text="15"
                        android:textColor="?attr/pbColorTextBody"
                        android:textSize="9sp" />
                </FrameLayout>

                <ImageButton
                    android:id="@+id/playPauseButton"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="28dp"
                    android:layout_marginEnd="28dp"
                    android:background="@drawable/bg_play_button_round"
                    android:contentDescription="@string/detail_play_pause"
                    android:padding="14dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_play_arrow"
                    app:tint="?attr/colorOnPrimary" />

                <FrameLayout
                    android:id="@+id/forwardButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/detail_forward_30">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_forward_media"
                        app:tint="?attr/pbColorTextBody" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="3dp"
                        android:fontFamily="sans-serif-medium"
                        android:importantForAccessibility="no"
                        android:text="30"
                        android:textColor="?attr/pbColorTextBody"
                        android:textSize="9sp" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
