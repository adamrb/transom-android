<?xml version="1.0" encoding="UTF-8"?>
<!-- Overrides the SDK's res/raw/logback.xml via Android resource merging (app wins over AAR).
     Retention kept deliberately short (3 days / 100MB): these files end up in exported .plaud
     support bundles, so the app also never logs tokens, response bodies, transcript text, or
     user ids — status codes and byte counts only. -->
<configuration>
    <!-- LOG_DIR is set programmatically in the SDK's Logger -->

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <immediateFlush>true</immediateFlush>

        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>

        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/plaud_sdk_%d{yyyy-MM-dd_HH}_%i.log</fileNamePattern>

            <!-- Max size of a single log file -->
            <maxFileSize>20MB</maxFileSize>

            <!-- Keep 3 days of hourly files (3 x 24) -->
            <maxHistory>72</maxHistory>

            <!-- Total size cap across all log files -->
            <totalSizeCap>100MB</totalSizeCap>

            <cleanHistoryOnStart>true</cleanHistoryOnStart>
        </rollingPolicy>
    </appender>

    <root level="INFO">
        <appender-ref ref="FILE" />
    </root>
</configuration>
